# Copy to server/docker/.env (next to docker-compose.yaml). Never commit the real file.

# Tool API keys. Leave blank to disable the corresponding tool.
OPENWEATHERMAP_API_KEY=
FINNHUB_API_KEY=
GOOGLE_API_KEY=            # Places, Geocoding, and Translate
NEWSDATA_API_KEY=

# Home Assistant MCP server (see tools_server/mcp-servers.yaml)
HOMEASSISTANT_TOKEN=       # long-lived access token

# Push notifications via ntfy (push_notify tool). Topic is required to enable.
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Optional: only needed if vLLM has to pull a gated model from the Hub.
HF_TOKEN=

# Container user for the orchestrator (matches host ownership of /ai/server/state)
UID=1000
GID=1000
