{
  "uid": "assistant-overview",
  "title": "Assistant Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Host CPU Usage (%)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100",
          "legendFormat": "cpu"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Host Memory Usage (%)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes))",
          "legendFormat": "mem"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Disk Usage (%)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "100 * (1 - (node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}))",
          "legendFormat": "disk"
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "GPU Utilization (%)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
          "legendFormat": "gpu"
        }
      ],
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 6
      }
    },
    {
      "type": "stat",
      "title": "Host Uptime (s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "node_time_seconds - node_boot_time_seconds"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 6,
        "h": 4
      }
    },
    {
      "type": "timeseries",
      "title": "Container CPU (cores)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum by (container_label_com_docker_compose_service) (rate(container_cpu_usage_seconds_total{id=~\"/system.slice/docker-.*\\\\.scope\",cpu=\"total\",container_label_com_docker_compose_service!=\"\"}[1m]))",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "gridPos": {
        "x": 6,
        "y": 6,
        "w": 9,
        "h": 6
      }
    },
    {
      "type": "timeseries",
      "title": "Container Memory (bytes)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "container_memory_usage_bytes{id=~\"/system.slice/docker-.*\\\\.scope\",container_label_com_docker_compose_service!=\"\"}",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "gridPos": {
        "x": 15,
        "y": 6,
        "w": 9,
        "h": 6
      }
    },
    {
      "type": "table",
      "title": "Container Uptime (s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "time() - container_start_time_seconds{id=~\"/system.slice/docker-.*\\\\.scope\",container_label_com_docker_compose_service!=\"\"}",
          "legendFormat": "{{container_label_com_docker_compose_service}}"
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 6
      }
    }
  ]
}
