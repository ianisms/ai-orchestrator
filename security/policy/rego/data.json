{
  "limits": {
    "max_chain": 2,
    "max_token_age_s": 300,
    "voice_min_confidence": 0.98
  },
  "tools": {
    "github.get_pr": {
      "class": "read",
      "scope": "repo:read",
      "resource_arg": "repo",
      "risk": "low"
    },
    "github.list_files": {
      "class": "read",
      "scope": "repo:read",
      "resource_arg": "repo",
      "risk": "low"
    },
    "github.comment": {
      "class": "write",
      "scope": "repo:write",
      "resource_arg": "repo",
      "risk": "normal"
    },
    "github.merge_pr": {
      "class": "write",
      "scope": "repo:write",
      "resource_arg": "repo",
      "risk": "high"
    },
    "jira.get_issue": {
      "class": "read",
      "scope": "issues:read",
      "resource_arg": "project",
      "risk": "low"
    },
    "jira.create_issue": {
      "class": "write",
      "scope": "issues:write",
      "resource_arg": "project",
      "risk": "normal"
    }
  },
  "agents": {
    "mcp-gateway": {
      "tools": [
        "github.get_pr",
        "github.list_files",
        "github.comment",
        "github.merge_pr",
        "jira.get_issue",
        "jira.create_issue"
      ]
    },
    "code-review-subagent": {
      "tools": [
        "github.get_pr",
        "github.list_files"
      ]
    }
  }
}
